DAYBRIEF_MODE=mock
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEWS_LOOKBACK_HOURS=24
ENRICHMENT_MAX_CANDIDATES=6
ENRICHMENT_QUERIES_PER_CANDIDATE=2
FALLBACK_MAX_CANDIDATES=6
FALLBACK_MAX_ARTICLES=40
DATABASE_URL=sqlite:///./daybrief.db
REQUEST_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Reuse successful briefs with at least two stories for 30 minutes.
DAYBRIEF_CACHE_ENABLED=true
DAYBRIEF_CACHE_TTL_SECONDS=1800

PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_DIR=.daybrief-cache
PROVIDER_CACHE_TTL_SECONDS=3600

# Video generation is opt-in and Azure may incur charges.
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
# Use the region of your Speech resource, not its endpoint URL.
AZURE_SPEECH_REGION=westus2
AZURE_SPEECH_VOICE=en-US-JennyNeural
VIDEO_OUTPUT_DIR=.daybrief-videos
VIDEO_FONT_PATH=
# Cartoon expression strength: 0 (still) to 1 (strong), with automatic serious-story restraint.
EXPRESSION_INTENSITY=0.7

# Visual plans reuse the bundled cat anchor without downloading news images.
# Visuals are stored under VIDEO_OUTPUT_DIR/visuals on the existing data volume.
